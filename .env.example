# SLA Dashboard Configuration
# Copy this file to .env and fill in your values

# IMAP Configuration (for reading job completion emails)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your-email@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_FOLDER=INBOX
IMAP_SSL=true

# SMTP Configuration (for sending summary emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Summary email settings
SUMMARY_RECIPIENT=your-email@gmail.com
SUMMARY_FROM=sla-dashboard@yourdomain.com
SUMMARY_CRON=0 0 18 * * ?

# Scheduler settings
SCHEDULER_ENABLED=true
EMAIL_CHECK_INTERVAL=300000

# Logging
LOG_LEVEL=INFO
